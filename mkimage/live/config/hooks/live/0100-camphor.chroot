#!/bin/sh
# live-build 的 chroot 钩子：镜像里那个根文件系统的收尾。
# 跑在 chroot 内、以 root 身份。仓库的 etc/ 与 usr/ 此时已由
# config/includes.chroot/ 铺到目标路径上。
set -e

# 仓库里检出时可能丢了执行位，脚本直接起不来
chmod +x /usr/local/bin/camphor-*.sh

# 屏蔽 network-online 的等待。
#
# 网络可能走无线、也可能没有插网线：等 network-online 会让开机停在
# "Waiting for Network to be Configured" 上两分钟，第二阶段被它挡住，
# 看起来就是卡在启动。能正常启动的旧系统里，这个单元是指向 /dev/null 的屏蔽状态。
# 我们的服务都只要求 After=network.target，不需要"网真的通了"。
rm -f /etc/systemd/system/network-online.target.wants/systemd-networkd-wait-online.service
ln -sf /dev/null /etc/systemd/system/systemd-networkd-wait-online.service

# 摘掉全部旧 X 驱动（DDX）。
#
# 能正常显示的旧系统里没有一个 xserver-xorg-video-* 包，X 用的是内核 DRM 上的
# modesetting 驱动 —— 它在 xserver-xorg-core 里，不随这些包走。
# 这一整套是这么进来的：xinit 推荐 xserver-xorg 元包，元包依赖
# xserver-xorg-video-all，后者把各家 DDX 全装上。其中 intel 那个在部分核显上
# 会画出灰屏；vesa / fbdev 这类退回路径在模式选错时同样会盖掉 modesetting。
# Debian 的包说明写明 video-all 只是依赖集合、想要哪些驱动就装哪些，可以直接删；
# 删它时依赖它的 xserver-xorg 元包会一起走，xserver-xorg-core 不动。
if dpkg -l 'xserver-xorg-video-*' 2>/dev/null | grep -q '^ii'; then
	DEBIAN_FRONTEND=noninteractive apt-get purge -y \
		xserver-xorg-video-all 'xserver-xorg-video-*' xserver-xorg
	echo "camphor: 已摘掉全部 xserver-xorg-video-*（X 走 modesetting）"
fi

# 摘完之后 X 必须还有 modesetting，否则一个驱动都不剩
if [ ! -f /usr/lib/xorg/modules/drivers/modesetting_drv.so ]; then
	echo "camphor: 没有 modesetting_drv.so，X 没有可用驱动" >&2
	exit 1
fi

# 摘掉 cron。
#
# 它不是清单里的包：logrotate 写的是
#   Depends: cron | anacron | cron-daemon | systemd-sysv
# apt 按备选顺序取了第一个，明明 systemd-sysv 已经在，还是装了个 cron。
# 它没有活可干：/etc/crontab 只有四条 run-parts，/etc/cron.d 只有
# e2fsprogs 的 e2scrub_all，而后者每条命令都以 `test -e /run/systemd/system ||`
# 开头 —— systemd 在跑就不执行；日志轮转走 logrotate.timer。
# cron-daemon-common 要一起摘：/etc/crontab 与 /etc/cron.* 的空目录是它的，
# 只摘 cron 会留下一份没人读的 crontab。
# 删掉之后 logrotate 的那条依赖仍由 systemd-sysv 满足。
if dpkg -l cron cron-daemon-common 2>/dev/null | grep -q '^ii'; then
	DEBIAN_FRONTEND=noninteractive apt-get purge -y cron cron-daemon-common
	echo "camphor: 已摘掉 cron（依赖备选顺带装进来的；logrotate 由 systemd-sysv 满足）"
fi

# initramfs 按仓库的 /etc/initramfs-tools 重建：内核包是构建时先装的，
# 它的 postinst 生成 initrd 时仓库这份配置还没铺进来，所以这里重做一次
# 钩子的 PATH 里没有 /usr/sbin，必须给绝对路径
/usr/sbin/update-initramfs -u -k all

# 菜单只认 /boot/vmlinuz 与 /boot/initrd.img，不写具体版本号，
# 换内核时只改这两个链接
cd /boot
kv=$(ls -1 vmlinuz-* 2>/dev/null | sed 's/^vmlinuz-//' | head -1)
if [ -z "$kv" ]; then
	echo "camphor: /boot 下没有内核" >&2
	exit 1
fi
ln -sf "vmlinuz-$kv" vmlinuz
ln -sf "initrd.img-$kv" initrd.img

# 引导菜单不进根文件系统：装好的系统由安装器调 grub-mkconfig 生成，
# 按 UUID 找根；内核命令行参数由安装器写的 etc/default/grub 提供。
# 账号不由镜像预置：账号与口令在安装时由安装者填，ksmbd 与 camphor-filemgr 里
# 按名字认人的两处由首次启动脚本改成那个账号。
# 镜像里预先放一个账号，等于把一份已知口令随介质发出去。


# 仓库里的单元按清单启用
# （Debian 自带的 ssh.service 保留在 22 口，camphor-ssh 走 2222，
#   两个都留：哪怕我们自己那套起不来，也还有一条进得去的路）
while read -r unit state; do
	case "$unit" in ''|'#'*) continue ;; esac
	if [ "$state" = enabled ]; then
		# 清单描述的是完整系统要有哪些服务。分层之后，应用服务不在主镜像这一层，
		# 单元文件根本不存在 —— 直接 enable 会让整个钩子以非零退出，构建停在这里。
		# 缺的跳过，装完应用层再启。
		if [ -f "/etc/systemd/system/$unit" ] || [ -f "/usr/lib/systemd/system/$unit" ]; then
			systemctl enable "$unit"
		else
			echo "camphor: $unit 不在这一层，跳过"
		fi
	fi
done < /etc/systemd/camphor-units.list

# 两个一次性入口单独启用。它们不写进上面的清单：那份清单同时是
# camphor-firstboot.sh 的启动名单，入口混在里面会被当成服务 start，
# 而 camphor-firstboot.service 就是正在跑那个脚本的单元，start 它会等自己。
for one in camphor-installer.service camphor-firstboot.service camphor-journal-flush.service; do
	[ -f "/etc/systemd/system/$one" ] || continue
	systemctl enable "$one"
done

# 网络只留一套：systemd-networkd 拿地址，camphor-wifi 拉自己那个 wpa_supplicant。
# ifupdown 的 networking.service 里没有任何 iface（/etc/network/interfaces 只有
# source 一行），是空跑；系统自带的 wpa_supplicant.service 也是空跑，而且它的
# 控制目录跟 camphor-wifi 抢同一个 /run/wpa_supplicant。
# 这个 chroot 里没有跑 systemd，systemctl 改不了状态（见下面定时器那段），
# 所以直接摘掉启用链接。
for unit in networking.service wpa_supplicant.service; do
	rm -f /etc/systemd/system/*.wants/"$unit"
	if ls /etc/systemd/system/*.wants/"$unit" >/dev/null 2>&1; then
		echo "camphor: $unit 仍被启用" >&2
		exit 1
	fi
	echo "camphor: 已关闭 $unit"
done

# 这几个定时器在成品系统上没有用处，屏蔽掉：
#   apt-daily / apt-daily-upgrade  界面里不装包，它每天自己联网拉一次索引 ——
#                                  走热点时那是白花的流量，还会重写 /var/lib/apt/lists
#   dpkg-db-backup                 每天把 /var/lib/dpkg 打包到 /var/backups；
#                                  系统坏了是重装，不是拿它修
#   logrotate                      它只管 /var/log 下的普通文件，而服务日志都在 journal，
#                                  journal 自己按上限滚动；剩下那几条规则对应的文件
#                                  在成品机上几乎不增长，跑了也是空转
# fstrim.timer 留着：SSD 定期 TRIM 有用。
#
# 屏蔽就是把它指向 /dev/null。不用 systemctl mask：这个 chroot 里没有运行中的
# systemd，那条命令会失败；失败一旦被吞掉，日志写着"已屏蔽"、镜像里还是启用状态。
# 写完逐条读回来确认，对不上就让构建停在这里。
for timer in apt-daily.timer apt-daily-upgrade.timer dpkg-db-backup.timer logrotate.timer; do
	[ -e "/usr/lib/systemd/system/$timer" ] || continue
	ln -sfn /dev/null "/etc/systemd/system/$timer"
	rm -f /etc/systemd/system/timers.target.wants/"$timer"
	if [ ! -L "/etc/systemd/system/$timer" ] || [ "$(readlink "/etc/systemd/system/$timer")" != /dev/null ]; then
		echo "camphor: 屏蔽 $timer 失败" >&2
		exit 1
	fi
	echo "camphor: 已屏蔽 $timer"
done

# networkd 不写 /etc/resolv.conf —— 那是 systemd-resolved 的活。把这份文件指到
# resolved 的 stub（127.0.0.53），DHCP 给的 DNS 才有地方落地。
rm -f /etc/resolv.conf
ln -s /run/systemd/resolve/stub-resolv.conf /etc/resolv.conf

# 界面挂在 graphical.target 上，默认目标得跟着改，否则图形界面永远不启动
systemctl set-default graphical.target

# leaffs 的依赖装进自己的 venv；--system-site-packages 是为了让 pywebview
# 用到系统里的 gi 与 WebKit
#
# leaffs 是应用，不在主镜像这一层：主镜像里没有 /opt/leaffs，这一段跳过。
# 应用层镜像构建时它在那里，装进 venv。
if [ -d /opt/leaffs ] && [ -f /opt/leaffs/requirements.txt ]; then
	python3 -m venv --system-site-packages /opt/leaffs/venv
	# 构建期用国内索引：直连 files.pythonhosted.org 会中途超时，
	# pywebview 的 proxy_tools 是源码包，下载断了整个 chroot 阶段就失败
	PIP_INDEX="https://pypi.tuna.tsinghua.edu.cn/simple"
	/opt/leaffs/venv/bin/pip install --no-cache-dir --retries 5 --timeout 60 \
		-i "$PIP_INDEX" -r /opt/leaffs/requirements.txt
else
	echo "camphor: 这一层没有 /opt/leaffs，跳过 venv"
fi

# 出厂状态里不该有身份：首次启动由 systemd 生成 machine-id、
# 由 camphor-ssh 的 ExecStartPre 生成主机密钥
: > /etc/machine-id
rm -f /etc/ssh/ssh_host_*

# 出厂状态里也不该有「构建过程」：pip 的 HTTP 缓存、安装日志、
# 旧解释器留下的字节码。它们不指向哪台机器，但能把构建做过什么说得很清楚，
# 而用户系统里这些东西没有任何用处。
rm -rf /root/.cache
find /var/log -maxdepth 1 -type f ! -name README -delete
rm -f /var/log/apt/* /var/log/apt/*.xz
rm -rf /var/log/journal/* /var/log/runit/*
: > /var/log/lastlog
: > /var/log/wtmp
: > /var/log/btmp
find /opt/leaffs -name __pycache__ -type d -prune -exec rm -rf {} + 2>/dev/null || true
