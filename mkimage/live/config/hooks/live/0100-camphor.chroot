#!/bin/sh
# live-build 的 chroot 钩子：镜像里那个根文件系统的收尾。
# 跑在 chroot 内、以 root 身份。仓库的 etc/ 与 usr/ 此时已由
# config/includes.chroot/ 铺到目标路径上。
set -e

# 仓库里检出时可能丢了执行位，脚本直接起不来
chmod +x /usr/local/bin/camphor-*.sh

# initramfs 按仓库的 /etc/initramfs-tools 重建：内核包是构建时先装的，
# 它的 postinst 生成 initrd 时仓库这份配置还没铺进来，所以这里重做一次
# 钩子的 PATH 里没有 /usr/sbin，必须给绝对路径
/usr/sbin/update-initramfs -u -k all

# 菜单只认 /boot/vmlinuz 与 /boot/initrd.img，不写具体版本号，
# 换内核时只改这两个链接
cd /boot
kv=$(ls -1 vmlinuz-* 2>/dev/null | sed 's/^vmlinuz-//' | head -1)
if [ -z "$kv" ]; then
	echo "camphor: /boot 下没有内核" >&2
	exit 1
fi
ln -sf "vmlinuz-$kv" vmlinuz
ln -sf "initrd.img-$kv" initrd.img

# 引导菜单不进根文件系统：装好的系统由 grub-installer 调 grub-mkconfig 生成，
# 按 UUID 找根；内核命令行参数由 etc/default/grub 提供，不在这里写死。
# 账号不由镜像预置：账号与口令由 debian-installer 问安装者，装完由 preseed 的
# late_command 把 ksmbd 与 camphor-filemgr 里按名字认人的两处改成那个账号。
# 镜像里预先放一个账号，等于把一份已知口令随介质发出去。


# 仓库里的单元按清单启用
# （Debian 自带的 ssh.service 保留在 22 口，camphor-ssh 走 2222，
#   两个都留：哪怕我们自己那套起不来，也还有一条进得去的路）
while read -r unit state; do
	case "$unit" in ''|'#'*) continue ;; esac
	if [ "$state" = enabled ]; then
		systemctl enable "$unit"
	fi
done < /etc/systemd/camphor-units.list

# 界面挂在 graphical.target 上，默认目标得跟着改，否则图形界面永远不启动
systemctl set-default graphical.target

# leaffs 的依赖装进自己的 venv；--system-site-packages 是为了让 pywebview
# 用到系统里的 gi 与 WebKit
python3 -m venv --system-site-packages /opt/leaffs/venv
# 构建期用国内索引：直连 files.pythonhosted.org 会中途超时，
# pywebview 的 proxy_tools 是源码包，下载断了整个 chroot 阶段就失败
PIP_INDEX="https://pypi.tuna.tsinghua.edu.cn/simple"
/opt/leaffs/venv/bin/pip install --no-cache-dir --retries 5 --timeout 60 \
	-i "$PIP_INDEX" -r /opt/leaffs/requirements.txt

# 出厂状态里不该有身份：首次启动由 systemd 生成 machine-id、
# 由 camphor-ssh 的 ExecStartPre 生成主机密钥
: > /etc/machine-id
rm -f /etc/ssh/ssh_host_*

# 出厂状态里也不该有「构建过程」：pip 的 HTTP 缓存、安装日志、
# 旧解释器留下的字节码。它们不指向哪台机器，但能把构建做过什么说得很清楚，
# 而用户系统里这些东西没有任何用处。
rm -rf /root/.cache
find /var/log -maxdepth 1 -type f ! -name README -delete
rm -f /var/log/apt/* /var/log/apt/*.xz
rm -rf /var/log/journal/* /var/log/runit/*
: > /var/log/lastlog
: > /var/log/wtmp
: > /var/log/btmp
find /opt/leaffs -name __pycache__ -type d -prune -exec rm -rf {} +
