#!/bin/sh
# 菜单条目的措辞：默认那套是 "Live system (amd64)"，与镜像的品牌不搭。
# 条目文本由 live-build 生成，这里在生成之后改名，并补一条安装项。
#
# 跑在 binary_includes 之后、binary_checksums 之前，cwd 是 binary/。
set -e

sed -i \
	-e 's/^menuentry "Live system (amd64)" --hotkey=l {/menuentry "试用 Camphor（Live，不安装）" --hotkey=l {/' \
	-e 's/^menuentry "Live system (amd64 fail-safe mode)" {/menuentry "试用 Camphor（安全显卡模式）" {/' \
	boot/grub/grub.cfg

# 「安装 Camphor」就是同一套 live 系统加 camphor.installer=1：启动器看到这个参数就
# 不进 kiosk，改从介质把安装器与依赖挂起来跑。条目照 Live 那条复制，只换标题、加参数。
awk '
	/^menuentry "试用 Camphor（Live，不安装）"/ { cap = 1 }
	cap { block[n++] = $0; if ($0 == "}") cap = 0; print; next }
	{ print }
	END {
		print ""
		print "menuentry \"安装 Camphor\" --hotkey=i {"
		for (i = 0; i < n; i++) {
			line = block[i]
			if (line ~ /^[ \t]*linux[ \t]/) { print line " camphor.installer=1"; continue }
			if (line ~ /^menuentry/ || line == "}") continue
			print line
		}
		print "}"
	}
' boot/grub/grub.cfg > boot/grub/grub.cfg.new
mv boot/grub/grub.cfg.new boot/grub/grub.cfg

# 装系统是这张介质唯一的正经用途，安装项排最前面，不要坠在一串子菜单后面。
# 生成时它是追加在末尾的：先整段摘出来，再插到第一个菜单项之前。
# （第一版按行流式插入，插的时候那段还没读到，结果整条菜单项丢了。）
awk '
	/^menuentry "安装 Camphor"/ { hold = 1 }
	hold { inst = inst $0 "\n"; if ($0 == "}") hold = 0; next }
	{ line[++n] = $0 }
	END {
		pos = 0
		for (i = 1; i <= n; i++) {
			if (line[i] ~ /^(submenu|menuentry)[ ]/) { pos = i; break }
		}
		if (pos == 0) { printf "%s", inst; pos = n + 1 }
		for (i = 1; i <= n; i++) {
			if (i == pos) printf "\n%s", inst
			print line[i]
		}
	}
' boot/grub/grub.cfg > boot/grub/grub.cfg.new
mv boot/grub/grub.cfg.new boot/grub/grub.cfg

# 试用这一类菜单项去掉：这套镜像的 live 环境里没有应用（应用是装完系统后
# 由第二阶段脚本装进去的），"试用"看到的只是一个空骨架，留着只会误导。
awk '
	/^menuentry "试用 Camphor/ { skip = 1 }
	skip { if ($0 == "}") skip = 0; next }
	{ print }
' boot/grub/grub.cfg > boot/grub/grub.cfg.new
mv boot/grub/grub.cfg.new boot/grub/grub.cfg

# 默认项与超时写在 grub.cfg 里，不依赖 config.cfg —— 那份是主题配置，
# 里面的 set 会不会生效取决于 source 的顺序，改它容易改了没反应。
# 菜单只是兜底：3 秒不选就直接进安装器，真正的选择都在网页里。
sed -i \
	-e "s/^submenu 'Advanced install options \.\.\.' --hotkey=a {/submenu '高级选项' --hotkey=a {/" \
	-e "s/^submenu 'Utilities\.\.\.' --hotkey=u {/submenu '工具' --hotkey=u {/" \
	-e "s/^[[:space:]]*menuentry \"UEFI Firmware Settings\" --hotkey=f {/	menuentry \"进入主板设置\" --hotkey=f {/" \
	-e "s/^[[:space:]]*menuentry \"Verify integrity of the boot medium\" --hotkey=v {/	menuentry \"校验启动介质\" --hotkey=v {/" \
	boot/grub/grub.cfg

# 「工具」子菜单摊平到主页。这一页只有三两条，主页位置大把空着，把固件设置和
# 校验介质藏进二级菜单纯属自我削减：装机的人要先多按一次才看得见有哪些功能。
# 摊平的做法是整段去掉 submenu 那层壳，里面的东西原样留在顶层 —— 里面两条都包在
# `if [ ... ]` 里，挪到顶层照样成立。
# 花括号靠计数认：里面的 menuentry 自己也带 {}，只看行尾 `}` 会把它们截断。
awk '
	/^submenu .工具. --hotkey=u \{/ { depth = 1; inmenu = 1; next }
	inmenu {
		tmp = $0; o = gsub(/\{/, "", tmp)
		tmp = $0; c = gsub(/\}/, "", tmp)
		# 深度回到 1 时的那个 `}` 是这个子菜单的壳，收在这里
		if (depth == 1 && o == 0 && c == 1) { inmenu = 0; next }
		depth += o - c
		# 子菜单里那份 theme.cfg 是壳自带的，顶层已经 source 过一次，不要重复
		if ($0 ~ /^[ \t]*source \/boot\/grub\/theme\.cfg[ \t]*$/) next
		print
		next
	}
	{ print }
' boot/grub/grub.cfg > boot/grub/grub.cfg.new
mv boot/grub/grub.cfg.new boot/grub/grub.cfg

# 默认项按标题指定，不用序号：菜单顺序会随条目增删变化，序号指错就会
# 启动到「工具」那种子菜单里。
sed -i '1a set default="安装 Camphor"\nset timeout=3' boot/grub/grub.cfg

echo "camphor: 引导菜单已改名并补上安装项"
grep -hE '^(menuentry|submenu)' boot/grub/grub.cfg
