#!/bin/sh
# live-build 的 auto/config：lb config 时执行，命令行参数全在这里。
# 每一项的理由见 mkimage/BUILD.md，不要在这里加没写进文档的选项。
set -e

# 取包用的镜像，四个变量各管一段：
#   MIRROR / MIRROR_SECURITY                    构建期装包用
#   MIRROR_BINARY / MIRROR_BINARY_SECURITY      写进目标系统 sources.list 用
#                                                （构建的清理阶段也会拿它跑 apt update）
# 部署在国内时四个都换成镜像站，否则同一条慢线路会被访问两遍。
MIRROR=${CAMPHOR_MIRROR:-http://deb.debian.org/debian/}
# 安全更新在镜像站上是另一个路径（debian-security），要一起换掉，
# 否则构建会卡在 security.debian.org 上
MIRROR_SECURITY=${CAMPHOR_MIRROR_SECURITY:-http://security.debian.org/}
# 写进目标系统 sources.list 的源。构建也会用它跑 chroot_archives 的清理，
# 所以它同样决定构建速度；默认保持上游。
MIRROR_BINARY=${CAMPHOR_MIRROR_BINARY:-http://deb.debian.org/debian/}
MIRROR_BINARY_SECURITY=${CAMPHOR_MIRROR_BINARY_SECURITY:-http://security.debian.org/}

# 推荐包一律不装（--apt-recommends false）。
# 清单是唯一来源；apt 默认装 Recommends，等于让每个包的维护者决定镜像里还有什么。
# 实际后果：xinit 推荐 xserver-xorg 元包、它再依赖 xserver-xorg-video-all，
# 把各家 DDX 全拉进来；linux-image 推荐 apparmor；openbox 推荐 obconf 与 scrot；
# libwebkit2gtk 推荐 gstreamer 插件。这些都不在清单里，却会随装随到。

# noauto 阻止 lb config 再次读取本文件而递归
lb config noauto \
	--mode debian \
	--system live \
	--distribution trixie \
	--archive-areas "main non-free-firmware" \
	--mirror-bootstrap "$MIRROR" \
	--mirror-chroot "$MIRROR" \
	--mirror-chroot-security "$MIRROR_SECURITY" \
	--mirror-binary "$MIRROR_BINARY" \
	--mirror-binary-security "$MIRROR_BINARY_SECURITY" \
	--binary-image iso-hybrid \
	--bootloaders grub-efi \
	--uefi-secure-boot enable \
	--chroot-filesystem squashfs \
	--chroot-squashfs-compression-type zstd \
	--initramfs live-boot \
	--initsystem systemd \
	--loadlin false \
	--linux-flavours amd64 \
	--linux-packages none \
	--image-name camphor \
	--iso-volume CAMPHOR \
	--iso-application Camphor \
	--iso-publisher Camphor \
	--checksums sha256 \
	--apt-indices false \
	--apt-source-archives false \
	--apt-recommends false \
	--apt-options "--yes --option Acquire::Languages=none" \
	--bootappend-live "boot=live components console=tty0 loglevel=4 net.ifnames=0"
