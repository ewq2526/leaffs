<?xml version="1.0" encoding="utf-8"?>
<!--
  LeafFS 对话框，结构对应网页 .modal-overlay + .modal-content：
  · 外层全屏：透明遮罩（**不压暗**；窗口铺满整屏、盖到系统栏那条），点空白关闭
  · 内层居中卡片：半透明玻璃 + 圆角 + 边框 + 边缘高光（代码按网页变量动态着色，
    取**反主题**配色，用来在网页之上拉开辨识度）
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp">

    <LinearLayout
        android:id="@+id/lfCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:id="@+id/lfTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/lf_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/lfMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/lf_text_secondary"
            android:textSize="13sp"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/lfContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <LinearLayout
            android:id="@+id/lfButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="end"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/lfCancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/lf_btn_outline_bg"
                android:gravity="center"
                android:minWidth="64dp"
                android:paddingLeft="14dp"
                android:paddingTop="8dp"
                android:paddingRight="14dp"
                android:paddingBottom="8dp"
                android:textColor="@color/lf_text_secondary"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/lfOk"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/lf_btn_primary_bg"
                android:gravity="center"
                android:minWidth="64dp"
                android:paddingLeft="14dp"
                android:paddingTop="8dp"
                android:paddingRight="14dp"
                android:paddingBottom="8dp"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
