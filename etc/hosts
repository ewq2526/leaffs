# 镜像里的 /etc/hosts。
#
# 主机名在 etc/hostname 里固定为 camphor，所以这一行也固定。缺了它，每次 sudo
# 都要解析主机名失败一次（unable to resolve host），邮件、部分守护进程也会等超时。
# 不带构建环境的任何痕迹 —— live-build 的 chroot_hacks 会删掉镜像里的这份文件，
# 由构建流程按仓库内容铺回来。
127.0.0.1	localhost
127.0.1.1	camphor
::1		localhost ip6-localhost ip6-loopback
fe00::0		ip6-localnet
ff00::0		ip6-mcastprefix
ff02::1		ip6-allnodes
ff02::2		ip6-allrouters
