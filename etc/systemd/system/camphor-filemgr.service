[Unit]
Description=Camphor file management service
After=network.target local-fs.target

[Service]
Type=simple
# 占位：装好的系统里由 d-i 改成安装者创建的账号及其主组
# （mkimage/live/config/includes.installer/preseed.cfg 的 late_command）
User=nobody
Group=nogroup
ExecStart=/usr/bin/python3 /opt/camphor/filemgr/main.py
Restart=always
RestartSec=2
StateDirectory=camphor
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/srv/files

[Install]
WantedBy=multi-user.target
