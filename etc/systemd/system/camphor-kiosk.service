[Unit]
Description=Camphor kiosk (leaffs desktop form: window + services in one process)
After=network.target
Conflicts=getty@tty1.service

[Service]
Type=simple
User=root
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
WorkingDirectory=/opt/leaffs
Environment=LEAFFS_KIOSK=1
Environment=LEAFFS_PROJECT_ROOT=/srv/leaffs
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/xinit /usr/local/bin/camphor-kiosk-session.sh -- :0 -nolisten tcp vt1
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target