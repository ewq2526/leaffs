[Unit]
Description=Camphor kiosk (leaffs desktop form: window + services in one process)
After=network.target leaffs.service
Wants=leaffs.service
Conflicts=getty@tty1.service

[Service]
Type=simple
User=root
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
WorkingDirectory=/opt/leaffs
Environment=LEAFFS_KIOSK=1
Environment=LEAFFS_ATTACH=1
Environment=LEAFFS_PROJECT_ROOT=/srv/leaffs
Environment=PYTHONUNBUFFERED=1
# launch.sh 先等 /dev/dri/card0 出现再 exec 成 xinit：显卡没就绪时不启动 X，
# 避免一次注定 no screens found 的失败和随之而来的黑屏
ExecStart=/usr/local/bin/camphor-kiosk-launch.sh
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target
