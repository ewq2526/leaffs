[Unit]
Description=WSD/LLMNR discovery for Camphor (ksmbd based)
After=network-online.target ksmbd.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/sbin/wsdd2 -N CAMPHOR -H Camphor
Restart=on-failure
RestartSec=3
DynamicUser=yes
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN
PrivateTmp=yes
PrivateDevices=yes

[Install]
WantedBy=multi-user.target
