[Unit]
Description=LeafFS web file manager
After=network.target

[Service]
Type=simple
User=leaf
Group=leaf
WorkingDirectory=/opt/leaffs
Environment=LEAFFS_PROJECT_ROOT=/srv/leaffs
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/leaffs/venv/bin/python -m leaffs
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
