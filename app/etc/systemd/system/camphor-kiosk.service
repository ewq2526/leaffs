[Unit]
Description=Camphor kiosk (leaffs desktop form: window + services in one process)
After=network.target leaffs.service
Wants=leaffs.service
Conflicts=getty@tty1.service
# 这套界面（X + WebKit）常驻约 1.5 GB：压测显示内存占满时它自己也只能压到约 1.2 GB。
# 低于 1.5 GB 的机器上起来就是 swap 风暴，
# 直接不启动；开机时由 camphor-lowmem-notice 把原因写到屏幕上。
ConditionMemory=1500M

[Service]
Type=simple
User=root
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
WorkingDirectory=/opt/leaffs
Environment=LEAFFS_KIOSK=1
Environment=LEAFFS_ATTACH=1
Environment=LEAFFS_PROJECT_ROOT=/srv/leaffs
Environment=PYTHONUNBUFFERED=1
# 部分核显上 WebKit 的加速合成会画出灰白一片（窗口在、内容不出现）。
# 关掉合成走软件绘制：这一屏就是一页网页，软件绘制完全够用。
Environment=WEBKIT_DISABLE_COMPOSITING_MODE=1
# launch.sh 先等 /dev/dri/card0 出现再 exec 成 xinit：显卡没就绪时不启动 X，
# 避免一次注定 no screens found 的失败和随之而来的黑屏
ExecStart=/usr/local/bin/camphor-kiosk-launch.sh
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target
