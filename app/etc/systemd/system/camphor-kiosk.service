[Unit]
Description=Camphor kiosk (fullscreen window showing the local leaffs page; the server runs in leaffs.service)
After=network.target leaffs.service
Wants=leaffs.service
Conflicts=getty@tty1.service
# 这套界面（X + WebKit）常驻约 1.5 GB：压测显示内存占满时它自己也只能压到约 1.2 GB。
# 低于 1.5 GB 的机器上起来就是 swap 风暴，
# 直接不启动；开机时由 camphor-lowmem-notice 把原因写到屏幕上。
ConditionMemory=1500M

[Service]
Type=simple
User=root
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
WorkingDirectory=/opt/leaffs
Environment=LEAFFS_KIOSK=1
Environment=LEAFFS_ATTACH=1
Environment=LEAFFS_PROJECT_ROOT=/srv/leaffs
Environment=PYTHONUNBUFFERED=1
# WebKit 的网络缓存、favicon 之类默认落在 ~/.cache，会一直往盘上写。
# XDG_CACHE_HOME 指到 /run 下的 tmpfs，这些写就留在内存里，重启自动清空。
# XDG_DATA_HOME 不动：localStorage 与 IndexedDB 在它下面，主题与偏好要跨重启保留。
RuntimeDirectory=camphor-cache
Environment=XDG_CACHE_HOME=/run/camphor-cache
# launch.sh 先等 /dev/dri/card0 出现再 exec 成 xinit：显卡没就绪时不启动 X，
# 避免一次注定 no screens found 的失败和随之而来的黑屏
# 以前这里还有一条 WEBKIT_DISABLE_COMPOSITING_MODE=1，说是为了避开"部分核显上加速
# 合成会画出灰白一片"。那个灰白是应用侧的问题，不是合成器的问题；拿全局关合成去绕，
# 代价是整屏走软件绘制，每次刷新都更贵。不要再加回来。
# WebKit 的 Cookie 存盘（跨重启不用重新登录），但它的 HSTS 库每轮询一次就可能提交
# 一次写；启动前用 tmpfs 盖住那一个子目录，写盘归零。
ExecStartPre=/usr/local/bin/camphor-kiosk-cache.sh
ExecStart=/usr/local/bin/camphor-kiosk-launch.sh
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target
