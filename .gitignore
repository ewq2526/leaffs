# LeafFS .gitignore

# 工作区（交接文档、工具、内核归档、备份、探针输出；不入库）
/.work/

# 运行数据：源码方式跑一次就会生出这三个目录，
# 里面有账号哈希、证书私钥、本机令牌、上传的文件，禁止入库
/config/
/shared_files/
/.cache/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/

# 打包产物
dist/
build/
*.spec

# 日志与生成物
*.log
leaffs.log
*.exe
*.img
*.tar.gz

# 发布镜像的构建产物，以及构建时铺进 chroot 的那份副本
/for-distribution/live/binary
/for-distribution/live/cache
/for-distribution/live/chroot
/for-distribution/live/config/includes.chroot
*.iso
*.squashfs

# 安全启动密钥
*.key
*.pem
*.p12
*.pfx