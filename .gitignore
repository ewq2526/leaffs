# LeafFS .gitignore
# 运行与构建产物不入库；源码与文档入库。

# Python
__pycache__/
*.py[cod]
*.egg-info/

# 运行数据（含口令哈希、证书私钥、本机令牌等敏感内容，禁止上传）
config/
shared_files/
.cache/

# 日志
*.log
leaffs.log

# 打包产物（根目录级 build/dist；随附二进制见下）
/build/
/dist/
/build_dist/

# 随附的第三方可执行程序与运行库（不入库；使用方自行放置或安装）
/leaffs/openssl.exe
/leaffs/aria2c.exe
/leaffs/ffmpeg.exe
/leaffs/libssl-3-x64.dll
/leaffs/libcrypto-3-x64.dll
/leaffs/zlib1.dll

# 归档区
/_archive/

# 编辑器与系统文件
.idea/
.vscode/
Thumbs.db
Desktop.ini
.DS_Store

# 临时文件
*.tmp
*.swp
~$*
.rnd
